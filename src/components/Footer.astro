---
import { siteConfig } from "../config";

const year = new Date().getFullYear();
---

<footer class="border-line mt-16 border-t">
  <div
    class="text-muted mx-auto flex max-w-5xl flex-col gap-4 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p>
      {siteConfig.name} · © {year}
    </p>
    <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label="Footer">
      <a
        href={siteConfig.social.github}
        rel="me noopener noreferrer"
        class="hover:text-ink">GitHub</a
      >
      <a
        href={siteConfig.social.linkedin}
        rel="me noopener noreferrer"
        class="hover:text-ink">LinkedIn</a
      >
      <a href={`mailto:${siteConfig.author.email}`} class="hover:text-ink"
        >Email</a
      >
      <a href="/rss.xml" class="hover:text-ink">RSS</a>
      <a href="/now" class="hover:text-ink">Now</a>
    </nav>
  </div>
</footer>
