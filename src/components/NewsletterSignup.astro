---
import { siteConfig } from "../config";

const action = siteConfig.newsletter.url;
---

{
  action ? (
    <form
      class="mt-4 flex max-w-md flex-col gap-2 sm:flex-row"
      action={action}
      method="post"
    >
      <label class="sr-only" for="email">
        Email
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        class="border-line bg-raised flex-1 border px-3 py-2 text-sm"
        placeholder="you@example.com"
      />
      <button
        type="submit"
        class="border-ink bg-ink text-canvas border px-4 py-2 text-sm"
      >
        {siteConfig.newsletter.label}
      </button>
    </form>
  ) : null
}
