---
import type { CollectionEntry } from "astro:content";
import { statusLabel } from "../lib/content";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
---

<article class="border-line bg-raised border p-5">
  <p class="text-faint font-mono text-xs uppercase">
    {statusLabel(entry.data.status)}
  </p>
  <h2 class="mt-2 font-serif text-xl">
    <a
      href={`/projects/${entry.id}`}
      class="text-ink hover:text-accent no-underline"
    >
      {entry.data.title}
    </a>
  </h2>
  <p class="text-muted mt-2 text-sm">{entry.data.description}</p>
  <p class="text-faint mt-3 font-mono text-xs">{entry.data.tags.join(" · ")}</p>
</article>
