---
import type { CollectionEntry } from "astro:content";
import { formatDate, isExternalWriting, writingHref } from "../lib/content";

interface Props {
  entry: CollectionEntry<"writing">;
  readingLabel?: string;
}

const { entry, readingLabel } = Astro.props;
const href = writingHref(entry);
const external = isExternalWriting(entry);
---

<article class="border-line border-b py-6">
  <p class="text-faint mb-1 font-mono text-xs tracking-wide uppercase">
    {formatDate(entry.data.pubDate)}
    {entry.data.featured ? " · Featured" : ""}
    {readingLabel && !external ? ` · ${readingLabel}` : ""}
    {external ? ` · ${entry.data.venue ?? "External"}` : ""}
  </p>
  <h2 class="font-serif text-2xl tracking-tight">
    <a
      href={href}
      class="text-ink hover:text-accent no-underline"
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
    >
      {entry.data.title}
      {external ? <span class="sr-only"> (opens in a new tab)</span> : null}
    </a>
  </h2>
  <p class="text-muted mt-2 max-w-prose">{entry.data.description}</p>
  {
    entry.data.tags.length > 0 ? (
      <ul class="text-faint mt-3 flex flex-wrap gap-2 p-0 font-mono text-xs">
        {entry.data.tags.map((tag) => (
          <li class="list-none">{tag}</li>
        ))}
      </ul>
    ) : null
  }
</article>
