---
interface Props {
  title?: string;
  type?: "note" | "warning";
}

const { title, type = "note" } = Astro.props;
---

<aside
  class:list={[
    "border-line bg-accent-soft my-6 border px-4 py-3 font-sans text-base",
    type === "warning" && "border-accent",
  ]}
>
  {title ? <p class="text-ink m-0 mb-2 font-medium">{title}</p> : null}
  <div class="text-muted [&_p]:m-0">
    <slot />
  </div>
</aside>
