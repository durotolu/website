---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Not found"
  description="This page does not exist."
  canonicalPath="/404"
  noindex={true}
>
  <div class="mx-auto max-w-2xl px-4 py-24 sm:px-6">
    <p class="text-faint font-mono text-xs tracking-widest uppercase">404</p>
    <h1 class="mt-2 font-serif text-4xl tracking-tight">
      This page is not here
    </h1>
    <p class="text-muted mt-4">
      The URL may be wrong, or the page moved. Try one of these instead.
    </p>
    <ul class="mt-8 space-y-2">
      <li><a href="/">Home</a></li>
      <li><a href="/writing">Writing</a></li>
      <li><a href="/projects">Projects</a></li>
      <li><a href="/notes">Notes</a></li>
      <li><a href="/about">About</a></li>
    </ul>
  </div>
</BaseLayout>
