---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byDateDesc, isPublished } from "../../lib/content";

const entries = (await getCollection("projects", isPublished)).sort(byDateDesc);
---

<BaseLayout
  title="Projects"
  description="Selected work, described without résumé padding."
  canonicalPath="/projects"
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="text-faint font-mono text-xs tracking-widest uppercase">
      Selected work
    </p>
    <h1 class="mt-2 font-serif text-4xl tracking-tight">Projects</h1>
    <p class="text-muted mt-4 max-w-prose">
      A short list. Each page covers the problem, the approach, and what I would
      change.
    </p>
    {
      entries.length > 0 ? (
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {entries.map((entry) => (
            <ProjectCard entry={entry} />
          ))}
        </div>
      ) : (
        <p class="text-muted mt-10">No projects listed yet.</p>
      )
    }
  </div>
</BaseLayout>
