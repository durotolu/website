---
import { getCollection, render } from "astro:content";
import Callout from "../../components/mdx/Callout.astro";
import Figure from "../../components/mdx/Figure.astro";
import TOC from "../../components/TOC.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  byDateDesc,
  formatDate,
  isExternalWriting,
  isPublished,
  readingTime,
  relatedByTags,
} from "../../lib/content";
import { articleJsonLd } from "../../lib/seo";

export async function getStaticPaths() {
  const entries = (await getCollection("writing", isPublished)).filter(
    (entry) => !isExternalWriting(entry),
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const native = (await getCollection("writing", isPublished))
  .filter((item) => !isExternalWriting(item))
  .sort(byDateDesc);
const index = native.findIndex((item) => item.id === entry.id);
const previous = index >= 0 ? native[index + 1] : undefined;
const next = index > 0 ? native[index - 1] : undefined;
const related = relatedByTags(entry, native);
const time = readingTime(entry.body ?? "");
const path = `/writing/${entry.id}`;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={path}
  ogType="article"
  ogImage={entry.data.heroImage ?? undefined}
  jsonLd={articleJsonLd({
    title: entry.data.title,
    description: entry.data.description,
    path,
    pubDate: entry.data.pubDate,
    updatedDate: entry.data.updatedDate,
  })}
>
  <article class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="text-faint font-mono text-xs">
      <a href="/writing" class="text-muted">Writing</a>
    </p>
    <header class="mt-4 max-w-3xl">
      <h1 class="font-serif text-4xl tracking-tight text-balance">
        {entry.data.title}
      </h1>
      <p class="text-muted mt-4 text-lg">{entry.data.description}</p>
      <p class="text-faint mt-4 font-mono text-xs">
        <time datetime={entry.data.pubDate.toISOString()}
          >{formatDate(entry.data.pubDate)}</time
        >
        {
          entry.data.updatedDate ? (
            <> · Updated {formatDate(entry.data.updatedDate)}</>
          ) : null
        }
        · {time.label}
      </p>
      {
        entry.data.tags.length > 0 ? (
          <ul class="text-faint mt-3 flex flex-wrap gap-2 p-0 font-mono text-xs">
            {entry.data.tags.map((tag) => (
              <li class="list-none">{tag}</li>
            ))}
          </ul>
        ) : null
      }
    </header>
    {
      entry.data.heroImage ? (
        <img
          src={entry.data.heroImage}
          alt={entry.data.heroImageAlt ?? ""}
          class="mt-8 w-full max-w-3xl"
          width="1200"
          height="630"
          fetchpriority="high"
        />
      ) : null
    }
    <div
      class="mt-10 lg:grid lg:grid-cols-[minmax(0,65ch)_14rem] lg:items-start lg:gap-12"
    >
      <div class="prose-article">
        <TOC headings={headings} />
        <Content components={{ Callout, Figure }} />
      </div>
    </div>
    <nav
      class="border-line mt-14 max-w-3xl border-t pt-6 text-sm"
      aria-label="Article"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:justify-between">
        {
          previous ? (
            <a href={`/writing/${previous.id}`} class="text-muted">
              Previous: {previous.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={`/writing/${next.id}`} class="text-muted sm:text-right">
              Next: {next.data.title}
            </a>
          ) : null
        }
      </div>
      {
        related.length > 0 ? (
          <div class="mt-8">
            <h2 class="font-serif text-lg">Related</h2>
            <ul class="mt-2 p-0">
              {related.map((item) => (
                <li class="list-none py-1">
                  <a href={`/writing/${item.id}`}>{item.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ) : null
      }
      <p class="mt-8">
        <a href="/writing">Back to writing</a>
      </p>
    </nav>
  </article>
</BaseLayout>
